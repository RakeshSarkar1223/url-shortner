<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener API</title>
    <style>
        :root { --primary: #6366f1; --bg: #f3f4f6; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
        
        .container { background: white; padding: 2rem; border-radius: 1rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); width: 400px; }
        
        h2 { text-align: center; color: #1f2937; margin-top: 0; }
        input { width: 100%; padding: 10px; margin: 8px 0; border: 1px solid #e5e7eb; border-radius: 6px; box-sizing: border-box; }
        button { width: 100%; padding: 10px; background: var(--primary); color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px; }
        button:hover { opacity: 0.9; }
        .secondary-btn { background: #9ca3af; margin-top: 10px; }
        
        .toggle-text { text-align: center; margin-top: 15px; font-size: 0.9rem; cursor: pointer; color: var(--primary); }
        .hidden { display: none; }
        .error { color: #ef4444; text-align: center; font-size: 0.9rem; margin-top: 5px; }
        
        /* Result Box */
        .result-box { margin-top: 20px; padding: 10px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; word-break: break-all; text-align: center; }
        .result-box a { color: var(--primary); font-weight: bold; text-decoration: none; }
    </style>
</head>
<body>

    <div id="authSection" class="container">
        <h2 id="authTitle">Login</h2>
        <form id="authForm">
            <input type="text" id="username" placeholder="Username" class="hidden"> <input type="email" id="email" placeholder="Email Address" required>
            <input type="password" id="password" placeholder="Password" required>
            <button type="submit" id="submitBtn">Login</button>
        </form>
        <div id="authError" class="error"></div>
        <p class="toggle-text" id="toggleAuth">Don't have an account? Register</p>
    </div>

    <div id="appSection" class="container hidden">
        <h2>✂️ Shorten URL</h2>
        <p style="text-align: center; color: #6b7280;">Welcome back, <span id="displayUsername">User</span>!</p>
        
        <form id="shortenForm">
            <input type="url" id="originalUrl" placeholder="Paste long URL here (https://...)" required>
            <button type="submit">Generate Short Link</button>
        </form>

        <div id="shortResult" class="result-box hidden">
            <small>Your Short Link:</small><br>
            <a id="shortLink" href="#" target="_blank">...</a>
        </div>

        <button class="secondary-btn" id="logoutBtn">Logout</button>
    </div>

    <script>
        // State
        let isRegistering = false;
        
        // Elements
        const authSection = document.getElementById('authSection');
        const appSection = document.getElementById('appSection');
        const authForm = document.getElementById('authForm');
        const usernameInput = document.getElementById('username');
        const toggleText = document.getElementById('toggleAuth');
        const authTitle = document.getElementById('authTitle');
        const submitBtn = document.getElementById('submitBtn');
        const authError = document.getElementById('authError');

        // 1. Check if user is already logged in on load
        async function checkAuth() {
            try {
                // We use your existing /test-auth route to check login status
                const res = await fetch('/api/auth/test-auth');
                const data = await res.json();
                if (res.ok) {
                    showApp(data.user);
                }
            } catch (err) {
                console.log("Not logged in");
            }
        }
        checkAuth();

        // 2. Handle Login / Register Toggle
        toggleText.addEventListener('click', () => {
            isRegistering = !isRegistering;
            if (isRegistering) {
                authTitle.innerText = "Register";
                submitBtn.innerText = "Register";
                toggleText.innerText = "Already have an account? Login";
                usernameInput.classList.remove('hidden');
                usernameInput.required = true;
            } else {
                authTitle.innerText = "Login";
                submitBtn.innerText = "Login";
                toggleText.innerText = "Don't have an account? Register";
                usernameInput.classList.add('hidden');
                usernameInput.required = false;
            }
            authError.innerText = "";
        });

        // 3. Handle Auth Submission
        authForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const username = document.getElementById('username').value;

            const endpoint = isRegistering ? '/api/auth/register' : '/api/auth/login';
            const body = isRegistering ? { username, email, password } : { email, password };

            try {
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const data = await res.json();

                if (!res.ok) throw new Error(data.error || 'Auth failed');
                
                // If Registering, auto-switch to login or auto-login
                if (isRegistering) {
                    alert("Registration Successful! Please Login.");
                    toggleText.click(); // Switch to login view
                } else {
                    // Login successful
                    showApp({ username: data.username });
                }
            } catch (err) {
                authError.innerText = err.message;
            }
        });

        // 4. Handle URL Shortening
        document.getElementById('shortenForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const originalUrl = document.getElementById('originalUrl').value;
            
            try {
                const res = await fetch('/api/shorten', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ originalUrl }) // Matches your controller req.body
                });
                const data = await res.json();

                if (res.ok) {
                    const fullShortUrl = `${window.location.origin}/api/${data.shortID}`;
                    const resultBox = document.getElementById('shortResult');
                    const link = document.getElementById('shortLink');
                    
                    link.href = fullShortUrl;
                    link.innerText = fullShortUrl;
                    resultBox.classList.remove('hidden');
                } else {
                    alert("Error: " + data.error);
                }
            } catch (err) {
                alert("Something went wrong");
            }
        });

        // 5. Handle Logout
        document.getElementById('logoutBtn').addEventListener('click', async () => {
            await fetch('/api/auth/logout', { method: 'POST' });
            window.location.reload();
        });

        // Helper to switch views
        function showApp(user) {
            authSection.classList.add('hidden');
            appSection.classList.remove('hidden');
            if(user && user.username) {
                document.getElementById('displayUsername').innerText = user.username;
            }
        }
    </script>
</body>
</html>